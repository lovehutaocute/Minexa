<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <ImageView
        android:id="@+id/widget_status_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/widget_status_dot"
        android:contentDescription="@string/widget_status_running" />

    <TextView
        android:id="@+id/widget_status_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_status_stopped" />

    <TextView
        android:id="@+id/widget_players_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="@color/indigo"
        android:textSize="11sp"
        android:textStyle="bold"
        android:text="--" />

    <TextView
        android:id="@+id/widget_metric_tps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:text="--" />

    <TextView
        android:id="@+id/widget_metric_memory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:text="--" />

    <TextView
        android:id="@+id/widget_metric_uptime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:text="--" />

    <TextView
        android:id="@+id/widget_metric_cpu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:text="--" />

    <ImageView
        android:id="@+id/widget_refresh_btn"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/widget_refresh_icon"
        android:background="@drawable/widget_icon_btn"
        android:contentDescription="@string/widget_refresh_cd"
        android:padding="7dp" />
</LinearLayout>
