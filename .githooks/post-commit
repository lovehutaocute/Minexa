#!/bin/sh
# Keep the local bare mirror in sync after every commit without making a
# successful commit depend on the mirror.
root=$(git rev-parse --show-toplevel) || exit 0
source="$root/.git"
mirror="$(dirname "$root")/$(basename "$root").git-backup"
log="$root/.git-backup.log"

if git --git-dir="$mirror" fetch --quiet "$source" \
  '+refs/heads/*:refs/heads/*' \
  '+refs/tags/*:refs/tags/*' \
  '+refs/stash:refs/backup/stash'; then
  printf '%s post-commit backup succeeded\n' "$(date -Iseconds)" >> "$log"
else
  printf '%s post-commit backup failed\n' "$(date -Iseconds)" >> "$log"
fi

exit 0
