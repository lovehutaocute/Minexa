#!/bin/sh
# Rewritten commits and moved refs must refresh the same local bare mirror.
root=$(git rev-parse --show-toplevel) || exit 0
source="$root/.git"
mirror="$(dirname "$root")/$(basename "$root").git-backup"
log="$root/.git-backup.log"

if git --git-dir="$mirror" fetch --quiet "$source" \
  '+refs/heads/*:refs/heads/*' \
  '+refs/tags/*:refs/tags/*' \
  '+refs/stash:refs/backup/stash'; then
  printf '%s post-rewrite backup succeeded\n' "$(date -Iseconds)" >> "$log"
else
  printf '%s post-rewrite backup failed\n' "$(date -Iseconds)" >> "$log"
fi

exit 0
